# Ders Defteri API yapılandırması.
# Sunucudaki gerçek dosya /opt/dersdefteri/.env — bu dosya yalnızca örnektir.

# Mevcut sevgiliapp Postgres container'ındaki AYRI veritabanı.
# Kullanıcı ve veritabanı ayrı olduğu için sevgiliapp verisine erişimi yoktur.
DATABASE_URL=postgresql://dersdefteri:DEGISTIR@postgres:5432/dersdefteri

# Mevcut Redis container'ı, ayrı mantıksal veritabanı (indeks 1).
# Anahtarlar ayrıca "dd:" önekiyle yazılır.
REDIS_URL=redis://redis:6379/1

# En az 32 karakter. Değiştirilirse tüm oturumlar düşer.
JWT_SECRET=DEGISTIR_uzun_rastgele_bir_deger

APPLE_BUNDLE_ID=adilemre.ONOOOO

# App Store Connect > Uygulama Bilgisi > Apple Kimliği (sayısal).
# Uygulama kaydı açılınca doldurulur; üretimde zorunludur.
APPLE_APP_APPLE_ID=

# App Store Server API anahtarı (isteğe bağlı).
# Boş bırakılırsa abonelik yine imzalı işlem + webhook ile çalışır.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/secrets/AuthKey.p8

# Sandbox testleri için Sandbox yaz.
APPSTORE_ENVIRONMENT=Production

PUBLIC_BASE_URL=https://dersdefteri.adilemree.xyz
SUPPORT_EMAIL=destek@adilemree.xyz
